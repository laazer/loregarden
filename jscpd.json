{
  "path": ["client/src"],
  "ignore": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/node_modules/**",
    "**/setupTests.ts",
    "**/testUtils/**"
  ],
  "minLines": 15,
  "minTokens": 100,
  "threshold": 1,
  "reporters": ["console"],
  "silent": false,
  "format": ["typescript", "tsx", "javascript", "jsx"]
}
